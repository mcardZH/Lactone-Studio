#include <winver.h>
1 ICON "@ICON@"
1 VERSIONINFO
 FILEVERSION @VERSION_COMMA@,0
 PRODUCTVERSION @VERSION_COMMA@,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
 BLOCK "StringFileInfo"
 BEGIN
  BLOCK "040904b0"
  BEGIN
   VALUE "CompanyName", "Zixuan Zhang\0"
   VALUE "FileDescription", "Ester Studio portable launcher\0"
   VALUE "FileVersion", "@VERSION@\0"
   VALUE "InternalName", "sciyue\0"
   VALUE "OriginalFilename", "Ester-Studio.exe\0"
   VALUE "ProductName", "Ester Studio\0"
   VALUE "ProductVersion", "@VERSION@\0"
   VALUE "Comments", "Local OpenBLAS experimental package\0"
  END
 END
 BLOCK "VarFileInfo"
 BEGIN
  VALUE "Translation", 0x409, 1200
 END
END
