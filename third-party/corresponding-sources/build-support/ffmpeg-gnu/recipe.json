  "guiValidated": false,
  "fullCodecMatrixValidated": false,
  "publicDistributionApproved": false,
  "guiScope": "Pending for this prefix-mapped DLL; the earlier candidate GUI result belongs to previousOutput.",
  "pathNormalization": "Resolve WORK, GNU_ROOT and GNU_BIN before invocation and normalize all source/build/tool paths to forward slashes. Prefix maps apply recursively; verification covers both slash variants.",
  "previousOutput": {
    "bytes": 2972052,
    "sha256": "262cfb4b3be42d570621ae23d1ecf2dd702f5ad703cd6c53a1acde341889f2fd"
