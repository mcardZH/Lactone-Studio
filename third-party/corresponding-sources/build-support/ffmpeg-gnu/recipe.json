    "-ffile-prefix-map=${WORK}=sy-ffmpeg-build",
    "-fmacro-prefix-map=${WORK}=sy-ffmpeg-build",
    "-fdebug-prefix-map=${WORK}=sy-ffmpeg-build",
    "-ffile-prefix-map=${GNU_ROOT}=gnu-toolchain",
    "-fmacro-prefix-map=${GNU_ROOT}=gnu-toolchain",
    "-fdebug-prefix-map=${GNU_ROOT}=gnu-toolchain"
  ],
  "privacyRepair": {
    "method": "compile-time file/macro/debug prefix maps for Opus and FFmpeg; final linker strips only local symbol/debug metadata",
    "binarySearchReplace": false,
    "hardeningAndAssertionsChanged": false,
    "componentMacrosChanged": false,
    "rawScanViews": [
      "raw",
      "utf16le-align0",
